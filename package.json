  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "check": "bash -n install.sh && for file in bin/*.mjs lib/*.mjs test/*.mjs scripts/*.mjs; do node --check \"$file\" || exit; done && node scripts/build-obsidian-plugin.mjs --check && node --check integrations/obsidian/agent-vault-wiki/main.js",
    "build:obsidian": "node scripts/build-obsidian-plugin.mjs",
    "test": "node --test",
    "prepack": "node scripts/build-obsidian-plugin.mjs --check"
  },
  "bin": {
    "agent-vault-skill": "./bin/vault-cli.mjs",
    "vault-cli": "./bin/vault-cli.mjs",
    "vault-mcp": "./bin/vault-mcp.mjs"
  },
  "keywords": [
    "omp",
    "skill",
    "obsidian",
    "llm-wiki",
